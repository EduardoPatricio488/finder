includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3

    # Eloquent models expose database columns and relationship properties
    # dynamically. These patterns only suppress PHPStan's generic Model/Collection
    # inference failures; application-specific types and all other error classes
    # remain visible and still fail CI.
    ignoreErrors:
        - identifier: property.notFound
          message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$.*\.$#'
        - identifier: property.notFound
          message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Collection<.*\\|Illuminate\\Database\\Eloquent\\Model::\$.*\.$#'
        - identifier: method.notFound
          message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model::.*\(\)\.$#'
