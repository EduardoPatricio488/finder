includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3

    # These are narrowly-scoped Eloquent/Livewire type-inference cases. The
    # runtime models and relations are real; Larastan loses the concrete model
    # type after dynamic relationship/aggregate calls in these legacy files.
    # Keep the ignores path-specific so unrelated static-analysis regressions
    # still fail CI.
    ignoreErrors:
        - identifier: property.notFound
          path: 'app/Livewire/.*'
          message: '#Illuminate\\Database\\Eloquent\\Model::\$#'
        - identifier: method.notFound
          path: 'app/Livewire/.*'
          message: '#Illuminate\\Database\\Eloquent\\Model::#'
        - identifier: method.notFound
          path: 'app/Livewire/BuilderEditor.php'
          message: '#Illuminate\\Database\\Eloquent\\Relations\\HasMany::withTrashed\(\)#'
        - identifier: property.notFound
          path: 'app/Livewire/AdminAssistant.php'
          message: '#App\\Models\\Customer::\$orders_sum_total#'
        - identifier: property.notFound
          path: 'app/Livewire/ProductCatalog.php'
          message: '#App\\Livewire\\ProductCatalog::\$(cartSubtotal|shipping|vat|cartProducts)#'
        - identifier: property.notFound
          path: 'app/Providers/AppServiceProvider.php'
          message: '#Illuminate\\Database\\Eloquent\\Model::\$(has_reports|has_ai)#'
        - identifier: property.notFound
          path: 'app/Services/StoreMailService.php'
          message: '#Illuminate\\Database\\Eloquent\\Model::\$(name|email)#'
        - identifier: assign.propertyType
          path: 'app/Livewire/PublicSite.php'
          message: '#PublicSite::\$page.*Illuminate\\Database\\Eloquent\\Model#'
        - identifier: return.type
          path: 'app/Livewire/BuilderEditor.php'
          message: '#BuilderEditor::createDefaultPage\(\).*SitePage.*Illuminate\\Database\\Eloquent\\Model#'
