includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3

    # Keep PHPStan strict everywhere else. The few scoped exceptions below are
    # framework inference gaps that are verified by the application code:
    # Livewire computed properties are exposed through get*Property() methods,
    # withSum()/withCount() add runtime aggregate attributes, and Larastan can
    # lose the concrete related model type through some Eloquent relation chains.
    # Every exception is restricted to the exact affected file/error shape.
    ignoreErrors:
        - identifier: method.notFound
          path: app/Livewire/BuilderEditor.php
          message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany::withTrashed\(\)\.$#'
        - identifier: return.type
          path: app/Livewire/BuilderEditor.php
          message: '#^Method App\\Livewire\\BuilderEditor::createDefaultPage\(\) should return App\\Models\\SitePage but returns Illuminate\\Database\\Eloquent\\Model\.$#'
        - identifier: assign.propertyType
          path: app/Livewire/PublicSite.php
          message: '#^Property App\\Livewire\\PublicSite::\$page \(App\\Models\\SitePage\) does not accept Illuminate\\Database\\Eloquent\\Model\.$#'
        - identifier: property.notFound
          path: app/Livewire/ProductCatalog.php
          message: '#^Access to an undefined property App\\Livewire\\ProductCatalog::\$(cartSubtotal|shipping|vat|cartProducts)\.$#'
