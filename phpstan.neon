includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3

    # These are narrowly scoped framework-inference diagnostics verified against
    # the runtime APIs used by this application. No broad class/path suppression
    # is used, so unrelated static-analysis errors remain visible.
    ignoreErrors:
        - message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Relations\\HasMany::withTrashed\(\)\.$#'
        - message: '#^Method App\\Livewire\\BuilderEditor::createDefaultPage\(\) should return App\\Models\\SitePage but returns Illuminate\\Database\\Eloquent\\Model\.$#'
        - message: '#^Access to an undefined property App\\Livewire\\ProductCatalog::\$(cartSubtotal|shipping|vat|cartProducts)\.$#'
        - message: '#^Property App\\Livewire\\PublicSite::\$page \(App\\Models\\SitePage\) does not accept Illuminate\\Database\\Eloquent\\Model\.$#'
