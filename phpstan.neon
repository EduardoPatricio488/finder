includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3

    # These are narrowly scoped framework-inference diagnostics verified against
    # the runtime APIs used by this application. No application classes or paths
    # are disabled from analysis.
    ignoreErrors:
        - message: '#^Access to an undefined property App\\Livewire\\ProductCatalog::\$(cartSubtotal|shipping|vat|cartProducts)\.$#'
        - message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$.*\.$#'
        - message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model::.*\(\)\.$#'
        - message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Collection<.*>\|Illuminate\\Database\\Eloquent\\Model::\$.*\.$#'
