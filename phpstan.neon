includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 3

    # Laravel relations can lose their concrete model type when a query is
    # transformed through dynamic Eloquent APIs. These exceptions only cover
    # diagnostics whose receiver is the base Illuminate Model/Collection type;
    # errors reported against concrete application classes remain strict.
    ignoreErrors:
        - identifier: property.notFound
          message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model::.*$#'
        - identifier: property.notFound
          message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Collection<.*\\|Illuminate\\Database\\Eloquent\\Model::.*$#'
        - identifier: method.notFound
          message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model::.*$#'
